<?php

/**
 * @file
 * Install hooks for the deterministic end-to-end test seed.
 */

declare(strict_types=1);

use Drupal\Core\File\FileSystemInterface;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\Node;
use Drupal\node\Entity\NodeType;
use Drupal\taxonomy\Entity\Vocabulary;

/**
 * Implements hook_install().
 *
 * Creates a fixed set of content so end-to-end tests can assert exact
 * values. Everything created here is deterministic: titles, aliases and
 * revision log messages never change between runs.
 */
function next_tests_seed_install(): void {
  // A dedicated content type keeps the seed independent of the profile.
  if (!NodeType::load('next_test_page')) {
    NodeType::create([
      'type' => 'next_test_page',
      'name' => 'Next test page',
      'display_submitted' => FALSE,
    ])->save();
  }

  $pages = [
    'home' => [
      'title' => 'Next tests home',
      'alias' => '/next-tests/home',
    ],
    'about' => [
      'title' => 'Next tests about',
      'alias' => '/next-tests/about',
    ],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('node');

  foreach ($pages as $key => $values) {
    $uuid = '00000000-0000-0000-0000-00000000000' . ($key === 'home' ? '1' : '2');
    if ($storage->loadByProperties(['uuid' => $uuid])) {
      continue;
    }
    Node::create([
      'type' => 'next_test_page',
      'title' => $values['title'],
      'path' => ['alias' => $values['alias']],
      'status' => 1,
      'uuid' => $uuid,
      'revision_log_message' => 'Seed revision 1',
    ])->save();
  }

  // Second revision of the home page, kept as the default (published)
  // revision. The title is unchanged (specs assert it); the revision is
  // identifiable by its log message and its version id, so revision-aware
  // features (draft mode, resourceVersion) can be tested deterministically.
  $existing = $storage->loadByProperties([
    'type' => 'next_test_page',
    'title' => 'Next tests home',
  ]);
  $home = reset($existing);
  if ($home && count($storage->revisionIds($home)) < 2) {
    $home->setNewRevision(TRUE);
    $home->setRevisionLogMessage('Seed revision 2');
    $home->save();
  }

  // Allow anonymous JSON:API consumers to address non-default revisions,
  // so revision features (draft mode, resourceVersion) can be tested.
  \Drupal::configFactory()->getEditable('user.role.anonymous')
    ->set('permissions', array_merge(
      \Drupal::config('user.role.anonymous')->get('permissions') ?: [],
      ['view next_test_page revisions']
    ))
    ->save();

  // A menu link pointing at the home page, for menu-based features.
  if (\Drupal::moduleHandler()->moduleExists('menu_link_content')) {
    $link_storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
    if (!$link_storage->loadByProperties(['title' => 'Next tests home link'])) {
      $link_storage->create([
        'title' => 'Next tests home link',
        'menu_name' => 'main',
        'link' => ['uri' => 'internal:/next-tests/home'],
        'uuid' => '00000000-0000-0000-0000-0000000000aa',
      ])->save();
    }
  }

  // An image media, for media-based features (image rendering, meta alt).
  // The image media type ships with the standard install; kernel test
  // environments may enable media without its config, so guard on it.
  if (\Drupal::moduleHandler()->moduleExists('media')
    && \Drupal::entityTypeManager()->getStorage('media_type')->load('image')) {
    $media_storage = \Drupal::entityTypeManager()->getStorage('media');
    if (!$media_storage->loadByProperties(['name' => 'Next tests image'])) {
      $directory = 'public://next-tests';
      /** @var \Drupal\Core\File\FileSystemInterface $file_system */
      $file_system = \Drupal::service('file_system');
      if (!is_dir($directory)) {
        $file_system->mkdir($directory);
      }

      // A minimal valid 1x1 transparent PNG.
      $png = base64_decode('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==');
      file_put_contents('public://next-tests/next-tests.png', $png);
      $file = \Drupal::entityTypeManager()->getStorage('file')->create([
        'uri' => 'public://next-tests/next-tests.png',
        'status' => 1,
        'uid' => 1,
      ]);
      $file->save();

      $media_storage->create([
        'bundle' => 'image',
        'name' => 'Next tests image',
        'uid' => 1,
        'status' => 1,
        'field_media_image' => [
          'target_id' => $file->id(),
          'alt' => 'Deterministic next-drupal test image',
          'title' => 'Next tests image',
        ],
        'uuid' => '00000000-0000-0000-0000-0000000000bb',
      ])->save();
    }
  }

  // An article pattern (body + image + taxonomy tags) mirroring the
  // marketing/blog examples, so their spec families can be replayed against
  // deterministic content.
  next_tests_seed_create_article($storage);
}

/**
 * Creates the article content type, its fields and one seeded article.
 *
 * @param \Drupal\Core\Entity\EntityStorageInterface $storage
 *   The node storage.
 */
function next_tests_seed_create_article($storage): void {
  if (!NodeType::load('next_test_article')) {
    NodeType::create([
      'type' => 'next_test_article',
      'name' => 'Next test article',
      'display_submitted' => FALSE,
    ])->save();
  }

  $fields = [
    'next_test_body' => [
      'type' => 'text_with_summary',
      'label' => 'Body',
    ],
  ];
  foreach ($fields as $name => $settings) {
    if (!FieldStorageConfig::loadByName('node', $name)) {
      FieldStorageConfig::create([
        'field_name' => $name,
        'entity_type' => 'node',
        'type' => $settings['type'],
        'cardinality' => 1,
      ])->save();
    }
    if (!FieldConfig::loadByName('node', 'next_test_article', $name)) {
      FieldConfig::create([
        'field_name' => $name,
        'entity_type' => 'node',
        'bundle' => 'next_test_article',
        'label' => $settings['label'],
      ])->save();
    }
  }

  // Taxonomy tag reference, only when taxonomy is available.
  $tag = NULL;
  if (\Drupal::moduleHandler()->moduleExists('taxonomy')) {
    if (!FieldStorageConfig::loadByName('node', 'next_test_tags')) {
      FieldStorageConfig::create([
        'field_name' => 'next_test_tags',
        'entity_type' => 'node',
        'type' => 'entity_reference',
        'cardinality' => -1,
        'settings' => [
          'target_type' => 'taxonomy_term',
        ],
      ])->save();
    }
    if (!FieldConfig::loadByName('node', 'next_test_article', 'next_test_tags')) {
      FieldConfig::create([
        'field_name' => 'next_test_tags',
        'entity_type' => 'node',
        'bundle' => 'next_test_article',
        'label' => 'Tags',
        'settings' => [
          'handler' => 'default:taxonomy_term',
          'handler_settings' => [
            'target_bundles' => ['next_test_tags' => 'next_test_tags'],
          ],
        ],
      ])->save();
    }

    if (!Vocabulary::load('next_test_tags')) {
      Vocabulary::create([
        'vid' => 'next_test_tags',
        'name' => 'Next tests tags',
      ])->save();
    }
    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $existing = $term_storage->loadByProperties(['name' => 'Next tests tag']);
    $tag = reset($existing);
    if (!$tag) {
      $tag = $term_storage->create([
        'name' => 'Next tests tag',
        'vid' => 'next_test_tags',
        'uuid' => '00000000-0000-0000-0000-0000000000cc',
      ]);
      $tag->save();
    }
  }

  // Image reference, only when the seeded media exists.
  $media_id = NULL;
  if (\Drupal::moduleHandler()->moduleExists('media')) {
    $media = \Drupal::entityTypeManager()->getStorage('media')
      ->loadByProperties(['name' => 'Next tests image']);
    $media = reset($media);
    if ($media) {
      $media_id = $media->id();
      if (!FieldStorageConfig::loadByName('node', 'next_test_image')) {
        FieldStorageConfig::create([
          'field_name' => 'next_test_image',
          'entity_type' => 'node',
          'type' => 'entity_reference',
          'cardinality' => 1,
          'settings' => [
            'target_type' => 'media',
          ],
        ])->save();
      }
      if (!FieldConfig::loadByName('node', 'next_test_article', 'next_test_image')) {
        FieldConfig::create([
          'field_name' => 'next_test_image',
          'entity_type' => 'node',
          'bundle' => 'next_test_article',
          'label' => 'Image',
          'settings' => [
            'handler' => 'default:media',
            'handler_settings' => [
              'target_bundles' => ['image' => 'image'],
            ],
          ],
        ])->save();
      }
    }
  }

  $uuid = '00000000-0000-0000-0000-0000000000dd';
  if ($storage->loadByProperties(['uuid' => $uuid])) {
    return;
  }

  $values = [
    'type' => 'next_test_article',
    'title' => 'Next tests article',
    'next_test_body' => [
      'value' => 'Deterministic next-drupal test article body.',
      'format' => 'plain_text',
    ],
    'path' => ['alias' => '/next-tests/article'],
    'status' => 1,
    'uuid' => $uuid,
  ];
  if ($tag) {
    $values['next_test_tags'] = ['target_id' => $tag->id()];
  }
  if ($media_id) {
    $values['next_test_image'] = ['target_id' => $media_id];
  }

  Node::create($values)->save();
}
